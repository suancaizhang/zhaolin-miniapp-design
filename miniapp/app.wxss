page {
  --gallery-page: #f3f0ea;
  --gallery-surface: #faf8f3;
  --gallery-text: #292721;
  --gallery-muted: #6e685f;
  --gallery-border: #dcd7ce;
  --gallery-accent: #8f332b;
  --gallery-soft: #f4e8e3;
  --td-brand-color: #8f332b;
  --td-button-primary-bg-color: #8f332b;
  --td-button-primary-border-color: #8f332b;
  --td-button-primary-color: #faf8f3;
  --td-button-border-radius: 6px;
  --td-button-medium-height: 44px;
  --td-button-large-height: 48px;
  --td-button-default-bg-color: #faf8f3;
  --td-button-default-color: #292721;
  --td-button-default-border-color: #dcd7ce;
  --td-tag-primary-color: #8f332b;
  --td-tag-primary-light-color: #f4e8e3;
  --td-loading-color: #8f332b;
  --td-loading-text-color: #6e685f;
  --td-empty-description-color: #6e685f;
  background: var(--gallery-page);
  color: var(--gallery-text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 15px;
  line-height: 1.6;
}
view, navigator, button { box-sizing: border-box; }
.page { padding: 24px 16px 32px; }
.detail-page { padding-bottom: calc(32px + env(safe-area-inset-bottom)); }
.page-title { display: block; margin-bottom: 8px; font-size: 22px; font-weight: 600; line-height: 1.35; overflow-wrap: anywhere; }
.intro, .muted { color: var(--gallery-muted); }
.intro { display: block; margin: 0; }
.section { margin-top: 32px; }
.section-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
.section-title { font-size: 18px; font-weight: 600; }
.surface { background: var(--gallery-surface); border: 1px solid var(--gallery-border); border-radius: 12px; overflow: hidden; }
.stack > view, .stack > work-card { display: block; margin-bottom: 16px; }
.catalog-grid { display: flex; flex-wrap: wrap; margin: -6px; }
.catalog-item { width: 50%; min-width: 0; padding: 6px; }
.body-copy { display: block; white-space: pre-wrap; overflow-wrap: anywhere; }
.feedback { margin: 16px 0; padding: 16px; border: 1px solid var(--gallery-border); border-radius: 6px; background: var(--gallery-surface); color: var(--gallery-accent); }
.refreshing { margin: 12px 0; color: var(--gallery-muted); font-size: 13px; }
.actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
.actions > t-button { min-width: 120px; }
.back-row { margin-bottom: 16px; }
@media (max-width: 350px) { .catalog-item { width: 100%; } }
