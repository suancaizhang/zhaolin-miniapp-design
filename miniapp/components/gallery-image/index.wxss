:host { display: block; }
.frame { position: relative; width: 100%; min-height: 44px; background: var(--gallery-surface, #faf8f3); }
.artwork { display: block; width: 100%; height: 100%; }
.image-state { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; padding: 16px; box-sizing: border-box; text-align: center; color: var(--gallery-muted, #6e685f); font-size: 13px; }
.appreciate { position: absolute; inset: 0; display: flex; justify-content: flex-end; align-items: flex-end; width: 100%; height: 100%; min-height: 44px; margin: 0; padding: 12px; border: 0; border-radius: 0; background: transparent; line-height: 1.6; }
.appreciate::after { border: 0; }
.hint { padding: 4px 8px; border: 1px solid var(--gallery-border, #dcd7ce); border-radius: 6px; background: var(--gallery-surface, #faf8f3); color: var(--gallery-muted, #6e685f); font-size: 12px; }
