<view class="page detail-page">
  <view class="back-row"><t-button variant="text" bind:tap="backToGallery">‹ {{backLabel}}</t-button></view>
  <content-state wx:if="{{state !== 'ready'}}" state="{{state}}" message="{{error}}" back bind:retry="load" bind:back="openCatalog" />
  <block wx:else>
    <text class="page-title">{{series.name}}</text>
    <text wx:if="{{series.description}}" class="intro body-copy">{{series.description}}</text>
    <view wx:if="{{refreshing}}" class="refreshing">正在更新系列…</view>
    <view wx:if="{{error}}" class="feedback"><text>{{error}} 当前保留上次载入的内容。</text><t-button variant="text" theme="primary" bind:tap="load">重新载入</t-button></view>
    <view class="section">
      <view class="section-heading"><text class="section-title">系列作品</text><text class="muted">{{works.length}} 件</text></view>
      <view wx:if="{{works.length}}" class="catalog-grid"><view wx:for="{{works}}" wx:key="id" class="catalog-item"><work-card work="{{item}}" /></view></view>
      <content-state wx:else state="empty" message="本系列暂无作品" back bind:back="openCatalog" />
    </view>
  </block>
</view>
