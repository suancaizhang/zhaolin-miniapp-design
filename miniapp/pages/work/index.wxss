.image-caption { padding: 12px 16px; }
.work-intro { margin-top: 24px; }
.description { margin-top: 16px; }
.metadata { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--gallery-border); font-size: 13px; }
.metadata > view { display: flex; align-items: baseline; gap: 16px; margin-bottom: 8px; overflow-wrap: anywhere; }
.metadata-label { flex-shrink: 0; min-width: 64px; color: var(--gallery-muted); }
.share-button { min-height: 48px; margin: 24px 0 0; padding: 12px 16px; border: 1px solid var(--gallery-accent); border-radius: 6px; background: var(--gallery-accent); color: var(--gallery-surface); font-size: 15px; line-height: 1.6; font-weight: 500; }
.share-button::after { border: none; }
.stage { margin-top: 24px; }
.stage-title { display: block; margin-bottom: 12px; font-size: 17px; font-weight: 600; }
.record { margin-bottom: 16px; }
.record-copy { padding: 16px; }
.record-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 8px; }
.record-date { font-size: 13px; color: var(--gallery-muted); }
