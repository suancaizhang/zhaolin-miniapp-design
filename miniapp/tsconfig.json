{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["miniprogram-api-typings"],
    "lib": ["ES2020"],
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "../shared/types.ts"],
  "exclude": ["miniprogram_npm", "node_modules"]
}
