{
  "projectname": "zhaolin-gallery-local",
  "compileType": "miniprogram",
  "miniprogramRoot": "miniapp/",
  "libVersion": "3.17.5",
  "setting": {
    "useCompilerPlugins": ["typescript"],
    "es6": true,
    "enhance": true,
    "minified": true,
    "minifyWXSS": true,
    "minifyWXML": true,
    "ignoreUploadUnusedFiles": true,
    "uploadWithSourceMap": false
  },
  "packOptions": {
    "ignore": [
      { "type": "file", "value": "package.json" },
      { "type": "file", "value": "tsconfig.json" }
    ],
    "include": []
  }
}
